      }
    },
    {
      "id": "richfields",
      "name": "Rich fields",
      "description": "A denser board (32000 halite at turn 0), so more cells are worth contesting and the collision rule bites harder. Rules identical.",
      "game_config": {
        "players": [
          {
            "name": "Fleet A"
          },
          {
            "name": "Fleet B"
          },
          {
            "name": "Fleet C"
          },
          {
            "name": "Fleet D"
          }
        ],
        "num_agents": 4,
