      "game_config": {
        "players": [
          {
            "name": "Fleet A"
          },
          {
            "name": "Fleet B"
          },
          {
            "name": "Fleet C"
          },
          {
            "name": "Fleet D"
          }
        ],
        "num_agents": 4,
